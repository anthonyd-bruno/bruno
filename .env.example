# Repo-local support-bot defaults for developer smoke testing.
# Copy this file to .env and adjust locally as needed.

SUPPORT_BOT_LOCAL_PROVIDER=ollama
SUPPORT_BOT_OLLAMA_HOST=http://127.0.0.1:11434
SUPPORT_BOT_OLLAMA_MODEL=llama3.2
SUPPORT_BOT_OLLAMA_EMBEDDING_MODEL=mxbai-embed-large

# Optional: set GITHUB_TOKEN in your local .env or shell if you want GitHub discussions included.
# If you switch to the OpenAI local path, add OPENAI_API_KEY only in your local .env or shell.